# ==============================================================================
# SMARTW CẤU HÌNH CHO TỔ VIỄN THÔNG ĐÀ LẠT - MOBIFONE LÂM ĐỒNG
# ==============================================================================

# 1. TÀI KHOẢN SMARTW (Bắt buộc)
# Tài khoản SSO đăng nhập cổng https://smartw.mobifone.vn
SMARTW_USER=your_smartw_username
SMARTW_PASSWORD=your_smartw_password

# 2. PHẠM VI TỔ & ĐỊA BÀN (Cần khớp với tên trên cổng SmartW)
SMARTW_TEAM="TVT Đà Lạt"
SMARTW_GROUP="PVT Lâm Đồng"
SMARTW_TRUNG_TAM="MobiFone Lâm Đồng"
SMARTW_PROVINCE="Tỉnh Lâm Đồng"
SMARTW_REGION="MN"

# 3. KÊNH CẢNH BÁO TELEGRAM (Nhóm giám sát MLL Đà Lạt)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_group_chat_id"
TELEGRAM_ADMIN_ID="your_telegram_admin_id"

# 4. KÊNH CẢNH BÁO VIBER (Tùy chọn)
VIBER_BOT_TOKEN=""
VIBER_GROUP_ID=""

# 5. CẤU HÌNH THỜI GIAN & RUNNER
SCAN_INTERVAL_SECONDS=60
DEBUG_RETENTION_HOURS=2
MAX_ALARM_PAGESIZE=300
